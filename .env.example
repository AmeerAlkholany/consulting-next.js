# ==============================================================================
# Environment Configuration Template
# Psychological Consultation Booking Platform
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# Database
# ------------------------------------------------------------------------------
# DATABASE_URL: Pooled PostgreSQL connection string (e.g., via PgBouncer or Supabase transaction pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consulting?pgbouncer=true"

# DIRECT_URL: Direct PostgreSQL connection string used exclusively by `prisma migrate`
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/consulting"

# TEST_DATABASE_URL: Dedicated database for the Vitest database suites, which truncate
# the rows they create. Never point it at development data. Optional: without it the
# suites fall back to DATABASE_URL and wipe the development rows they exercise.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consulting_test"

# Application URL
# ------------------------------------------------------------------------------
# APP_URL: Canonical origin used in emails, absolute links, and CORS/CSRF checks
APP_URL="http://localhost:3000"

# Authentication & Sessions
# ------------------------------------------------------------------------------
# SESSION_COOKIE_NAME: Name of the session cookie (defaults to "session" if omitted)
SESSION_COOKIE_NAME="session"

# SESSION_TTL_DAYS: Absolute session lifespan in days (defaults to 7 if omitted)
SESSION_TTL_DAYS="7"

# Scheduled Jobs & Cron
# ------------------------------------------------------------------------------
# CRON_SECRET: Bearer authorization secret required for invoking /api/cron/* route handlers
CRON_SECRET="replace-with-a-secure-random-32-char-cron-secret"

# Sensitive Data Encryption
# ------------------------------------------------------------------------------
# NOTES_ENCRYPTION_KEY: Base64-encoded 32-byte AES-256-GCM key used for encrypting AppointmentNote body content
NOTES_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"

# NOTES_ENCRYPTION_KEY_ID: Identifier of the current active encryption key to enable key rotation
NOTES_ENCRYPTION_KEY_ID="k1"

# Server Actions Encryption (Multi-Instance)
# ------------------------------------------------------------------------------
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY: Stable key for Server Action closure encryption across multi-instance deployments
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Rate Limiting
# ------------------------------------------------------------------------------
# RATE_LIMIT_DRIVER: Storage driver for rate limiting ('memory' for local dev, 'redis' for production)
RATE_LIMIT_DRIVER="memory"

# REDIS_URL: Redis connection URL when RATE_LIMIT_DRIVER="redis" (standard Redis)
REDIS_URL=""

# UPSTASH_REDIS_REST_URL: Upstash REST endpoint when using Upstash Redis
UPSTASH_REDIS_REST_URL=""

# UPSTASH_REDIS_REST_TOKEN: Upstash REST authorization token
UPSTASH_REDIS_REST_TOKEN=""

# Email Delivery
# ------------------------------------------------------------------------------
# EMAIL_PROVIDER: Outbox delivery provider ('none' for local dev, 'resend', 'ses', 'smtp')
EMAIL_PROVIDER="none"

# EMAIL_API_KEY: Provider API key when EMAIL_PROVIDER is 'resend' or 'ses'
EMAIL_API_KEY=""

# EMAIL_FROM: Default sender email identity (e.g., "Consulting Platform <noreply@example.com>")
EMAIL_FROM="noreply@example.com"

# SMTP Credentials (when EMAIL_PROVIDER="smtp")
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Development Seed Admin Account
# ------------------------------------------------------------------------------
# SEED_ADMIN_EMAIL: Initial administrator email address created during database seeding
SEED_ADMIN_EMAIL="admin@example.com"

# SEED_ADMIN_PASSWORD: Initial password for the seeded admin account (forced reset on first sign-in)
SEED_ADMIN_PASSWORD="ChangeMeInDev123!"

# Observability & Monitoring
# ------------------------------------------------------------------------------
# LOG_LEVEL: Application logger level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL="info"

# SENTRY_DSN: Sentry project DSN for error reporting and telemetry (optional)
SENTRY_DSN=""

# Public Client-Side Environment Variables (Exposed to browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_APP_NAME: Display name of the platform shown across UI components
NEXT_PUBLIC_APP_NAME="Consulting Platform"

# NEXT_PUBLIC_SUPPORT_EMAIL: Support email address displayed on error and help surfaces
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
